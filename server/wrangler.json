{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "school-games-telemetry",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "school-games-telemetry" }
  ],
  "assets": { "directory": "./dashboard", "binding": "ASSETS" },
  "triggers": { "crons": ["23 3 * * *", "*/5 * * * *"] },
  "vars": {
    "ALLOWED_ORIGINS": "https://farmercarry.github.io",
    "RETENTION_DAYS": "400"
  },
  "observability": { "enabled": false }
}
